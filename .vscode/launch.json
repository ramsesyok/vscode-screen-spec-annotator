{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Screen Spec Annotator",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Screen Spec Annotator 文書編集の統合試験",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/node_modules/.cache/screen-spec-host-test.cjs"
      ],
      "preLaunchTask": "npm: build:host-test"
    }
  ]
}
